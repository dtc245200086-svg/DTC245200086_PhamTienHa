BILLING_APP_PASSWORD=CHANGE_ME_BILLING_APP_PASSWORD
BILLING_READONLY_PASSWORD=CHANGE_ME_BILLING_READONLY_PASSWORD
EXPORTER_PASSWORD=CHANGE_ME_EXPORTER_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_SECRET
SESSION_COOKIE_SECURE=true