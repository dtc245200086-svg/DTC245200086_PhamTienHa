# ============================================================================
# BILLING_ONE EXTENDED — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ============================================================================
# CRITICAL NOTICE:
# 1. Never commit real production secrets into version control.
# 2. Populate these values directly in your secure deployment pipeline,
#    Docker Secret store, Kubernetes Secret, or Cloud Secret Manager.
# 3. All passwords must be at least 32 characters, cryptographically random.
# ============================================================================

# Environment Profile (production | staging | test)
NODE_ENV=production

# Application Server Port (Internal container port)
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=billing
DB_USER=billing_app

# Database Credentials (REQUIRED — Replace in production)
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_SUPERUSER_PASSWORD
BILLING_APP_PASSWORD=CHANGE_ME_PRODUCTION_BILLING_APP_PASSWORD
BILLING_READONLY_PASSWORD=CHANGE_ME_PRODUCTION_BILLING_READONLY_PASSWORD
EXPORTER_PASSWORD=CHANGE_ME_PRODUCTION_EXPORTER_PASSWORD

# Application Administrative Accounts (REQUIRED — Replace in production)
ADMIN_PASSWORD=CHANGE_ME_PRODUCTION_ADMIN_USER_PASSWORD
STAFF_PASSWORD=CHANGE_ME_PRODUCTION_STAFF_USER_PASSWORD

# Session Security (REQUIRED — 32+ char random secret)
SESSION_SECRET=CHANGE_ME_PRODUCTION_SESSION_SECRET_AT_LEAST_32_BYTES
SESSION_COOKIE_SECURE=true

# Admin & Monitoring Dashboards (Disabled from public internet by default)
PGADMIN_DEFAULT_EMAIL=prod-admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PRODUCTION_PGADMIN_PASSWORD
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_PRODUCTION_GRAFANA_PASSWORD

# Production Nginx Rate Limiting Tuning (Requests per minute per IP for login)
NGINX_LOGIN_RATE_LIMIT=60r/m
NGINX_LOGIN_BURST=30
